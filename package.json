    "test:feeding": "node tools/browser-feeding-playtest.mjs",
    "test:camera": "node tools/browser-camera-playtest.mjs",
    "test:dash": "node tools/browser-dash-playtest.mjs",
    "test:gimmicks": "node tools/browser-gimmick-playtest.mjs",
    "test:transfer": "node tools/browser-transfer-playtest.mjs",
    "test:refuges": "node tools/browser-refuge-playtest.mjs",
